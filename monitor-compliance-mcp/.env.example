# Configurar no Railway. Nunca salvar senhas ou tokens no GitHub.
OAUTH_MODE=supabase-login
MCP_RESOURCE_URL=https://SEU-SERVICO.up.railway.app/mcp
OAUTH_DB_PATH=/data/oauth.sqlite
OAUTH_ALLOWED_SUBJECTS=UUID_DO_USUARIO_AUTORIZADO
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHAVE_PUBLICAVEL
WORKMONITOR_USER=USUARIO_WORKMONITOR
WORKMONITOR_PASSWORD=
PORT=8000
